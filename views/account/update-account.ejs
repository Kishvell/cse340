<%- include('../partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (message && message.length) { %>
            <div class="message">
                <%= message %>
            </div>
            <% } %>

                <% if (errors && errors.length) { %>
                    <ul class="errors">
                        <% errors.forEach(function(err){ %>
                            <li>
                                <%= err.msg %>
                            </li>
                            <% }) %>
                    </ul>
                    <% } %>

                        <!-- Account Update Form -->
                        <form action="/account/update" method="post" novalidate>
                            <fieldset>
                                <legend>Account Update</legend>

                                <label for="account_firstname">First name</label>
                                <input id="account_firstname" name="account_firstname" required
                                    value="<%= accountData?.account_firstname ? accountData.account_firstname : '' %>">

                                <label for="account_lastname">Last name</label>
                                <input id="account_lastname" name="account_lastname" required
                                    value="<%= accountData?.account_lastname ? accountData.account_lastname : '' %>">

                                <label for="account_email">Email</label>
                                <input id="account_email" name="account_email" required type="email"
                                    value="<%= accountData?.account_email ? accountData.account_email : '' %>">

                                <input type="hidden" name="account_id" value="<%= accountData?.account_id %>">

                                <input type="submit" value="Update Info">
                            </fieldset>
                        </form>

                        <!-- Change Password Form -->
                        <form action="/account/update-password" method="post" novalidate>
                            <fieldset>
                                <legend>Change Password</legend>

                                <p>Entering a new password will replace your current password. Password must be at least
                                    8 characters and include uppercase, lowercase, number, and special character.</p>

                                <label for="account_password">New Password</label>
                                <input id="account_password" name="account_password" type="password" required
                                    minlength="8" aria-describedby="pwHelp">
                                <div id="pwHelp">Minimum 8 chars, one uppercase, one lowercase, one number, one special
                                    char.</div>

                                <input type="hidden" name="account_id" value="<%= accountData?.account_id %>">

                                <input type="submit" value="Change Password">
                            </fieldset>
                        </form>
    </main>